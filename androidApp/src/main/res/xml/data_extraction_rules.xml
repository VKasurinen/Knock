<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted preferences can only be decrypted with a key from this device's Keystore,
     so they are excluded from cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>

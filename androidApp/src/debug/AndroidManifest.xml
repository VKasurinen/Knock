<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug only: allows plain HTTP to the local backend (localhost / 10.0.2.2) -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="28">

        <!-- Debug only: email links from the local backend (knock.email.url in application-dev.yml) -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http"
                    android:host="localhost"
                    android:port="8080" />

                <data android:pathPrefix="/api/auth/verify" />
                <data android:pathPrefix="/api/auth/reset-password" />
            </intent-filter>
        </activity>
    </application>
</manifest>
